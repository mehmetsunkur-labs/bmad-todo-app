# Copy to .env (never commit .env).

# PostgreSQL (db service). The api container builds its own DATABASE_URL
# from these values, pointing at the `db` service. They are inserted into the
# URL unencoded, so credentials must be URL-safe (no @ : / ? # % etc.).
POSTGRES_USER=todos
POSTGRES_PASSWORD=todos
POSTGRES_DB=todos

# API config (AD-10). This DATABASE_URL is for host-side commands
# (pnpm db:generate / db:migrate / test) against the dev db on port 5432.
# Its port must match DB_PORT below; change both together.
DATABASE_URL=postgres://todos:todos@localhost:5432/todos
PORT=3000
LOG_LEVEL=info

# Host ports: the web page, and the dev db (compose.override.yaml).
WEB_PORT=8080
# Must match the port in DATABASE_URL above.
DB_PORT=5432

# Dev stack only (compose.override.yaml). The dev web port binds 127.0.0.1
# (this machine only) by default. Set DEV_WEB_HOST=0.0.0.0 to reach the dev
# server from the LAN (for example a phone); anyone on the network can then
# reach it. Phones normally use the production-like stack instead.
# DEV_WEB_HOST=127.0.0.1
# Dev stack in Compose only: compose.override.yaml passes this into the web
# container. Extra host names the Vite dev server accepts (comma-separated),
# when you open it by name rather than by IP. Empty: localhost and IPs only.
# A Vite run on the host doesn't read this file; export it in the shell.
DEV_ALLOWED_HOSTS=
