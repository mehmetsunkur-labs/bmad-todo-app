# Copy to .env (never commit .env).

# PostgreSQL (db service). The api container builds its own DATABASE_URL
# from these values, pointing at the `db` service. They are inserted into the
# URL unencoded, so credentials must be URL-safe (no @ : / ? # % etc.).
POSTGRES_USER=todos
POSTGRES_PASSWORD=todos
POSTGRES_DB=todos

# API config (AD-10). This DATABASE_URL is for host-side commands
# (pnpm db:generate / db:migrate / test) against the dev db on port 5432.
# Its port must match DB_PORT below; change both together.
DATABASE_URL=postgres://todos:todos@localhost:5432/todos
PORT=3000
LOG_LEVEL=info

# Host ports: the web page, and the dev db (compose.override.yaml).
WEB_PORT=8080
# Must match the port in DATABASE_URL above.
DB_PORT=5432
