{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    // Typechecks the run-e2e.mjs orchestrator through its JSDoc.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
}
